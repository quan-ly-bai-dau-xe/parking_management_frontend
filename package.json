{
  "name": "parking-management-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test:unit": "node --test --test-reporter=dot \"tests/**/*.unit.test.mjs\"",
    "test:unit:verbose": "node --test --test-reporter=spec \"tests/**/*.unit.test.mjs\"",
    "test:integration": "node --test --test-reporter=dot \"tests/**/*.integration.test.mjs\"",
    "test:integration:verbose": "node --test --test-reporter=spec \"tests/**/*.integration.test.mjs\"",
    "test:risk": "node --test --test-reporter=dot tests/features/history/abnormalSessionRiskDefense.unit.test.mjs",
    "test:risk:verbose": "node --test --test-reporter=spec tests/features/history/abnormalSessionRiskDefense.unit.test.mjs",
    "storybook": "storybook dev -p 6006",
    "test:e2e": "playwright test",
    "test:e2e:compact": "playwright test --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e:compact",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.21.0",
    "lucide-react": "^1.65.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.12.0",
    "storybook": "^10.6.7",
    "vite": "^8.3.5"
  }
}

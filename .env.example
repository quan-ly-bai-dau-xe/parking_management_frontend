# ==============================================================================
# SMART PARKING MANAGEMENT - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Cấu hình Firebase Authentication (SMS Phone OTP)
# Lấy các thông số này từ Firebase Console: Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Cấu hình kết nối Backend API (mặc định sử dụng Vite dev server proxy tới http://localhost:8000)
VITE_API_BASE_URL=

